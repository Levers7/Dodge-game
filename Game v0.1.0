import simplegui
frame = simplegui.create_frame("", F, F)
#time stuffs
T = 0
HT = T
def time_handler():
    global T
    global HT
    T = T + 0.5
    HT = T
timer = simplegui.create_timer(500, time_handler)
timer.start()
# initialize state
current_key = ' '

# event handlers
def keydown(key):
    """
    Key down handler
    """
    global current_key
    current_key = chr(key)

def keyup(key):
    """
    Key up handler
    """
    global current_key
    current_key = ' '
   
def draw(canvas):
    """
    Draw handler, takes canvas as input
    """
    global current_key
    canvas.draw_text(current_key, [10, 25], 200, "Red")
    if current_key == 'W':
        print("eeeeeeee")
        
